<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The XML theme only matters for the split second before Compose draws (and for system
      dialogs). Its window background matches our dark background to avoid a white flash.
    -->
    <style name="Theme.PriorityRing" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
