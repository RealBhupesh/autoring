<?xml version="1.0" encoding="utf-8"?>
<!--
  Privacy: nothing is uploaded to Google cloud backup or copied by device-to-device transfer.
  Users back up macros explicitly with Export (a JSON file they control).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
